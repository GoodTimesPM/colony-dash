# Colony Dash config. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# `.env` is gitignored and never leaves the machine. The colony itself may never
# read it: agents run with `.env` outside their read scope, and the one loader
# that does read it (`colony/mirror.py:load_env`) is only ever called by the
# pulse. If an agent tells you a setting is missing because it could not see
# this file, that is the design working, not a bug.
#
# Every key here is optional. With none of them set, the dashboard, the ledger,
# the pulse and the console all still run — you just get no Notion intake and no
# MySQL mirror.

# --- where the colony may read -----------------------------------------------
# The directory of projects this colony watches. Read scope for every agent;
# write scope is always narrower and always set per ticket.
#
# Defaults to the folder containing this checkout, which is the intended layout:
#
#     projects/
#       colony-dash/     <- this repo
#       some-other-app/
#       another-thing/
#
# Set it only if your checkout does not live beside the projects it manages.
# COLONY_PROJECTS_ROOT=/home/you/projects

# --- reaching the dashboard from a phone -------------------------------------
# Only needed if you run `py -m colony dash --host <address>` to serve the
# dashboard off this machine. On the default 127.0.0.1 bind it is ignored.
#
# The server refuses to start on a non-loopback address without it, on purpose:
# the dashboard is the whole ledger, the project tree, every run transcript and
# a button that spends money. Generate one and paste it here:
#
#     py -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Then open http://<address>:8787 on the phone once and paste the same value in,
# or visit http://<address>:8787/?k=<token> and it logs itself in.
#
# Serve on a tailnet address (Tailscale, WireGuard) rather than 0.0.0.0 if you
# can. This token is meant to be the second lock, not the only one.
# COLONY_ACCESS_TOKEN=

# --- Notion intake -----------------------------------------------------------
# Optional. Without it the board still works — stories can be filed straight
# from the dashboard with "＋ story" on the board panel. Notion is one source of
# work, not the only one.
#
# Paste the "Internal Integration Secret" from
#   https://www.notion.so/profile/integrations  ->  your integration  ->  Configuration
# It starts with ntn_ (older ones start with secret_).
# Then, on the database you want read: ••• -> Connections -> add the integration.
# Forgetting that second step is the usual cause of an empty intake with a
# perfectly valid token.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- MySQL reporting mirror (optional; `py -m colony mirror`) -----------------
# One-way. SQLite stays the system of record, so this is safe to drop and
# rebuild. Needs PyMySQL or mysql-connector-python — see requirements.txt.
COLONY_MYSQL_HOST=127.0.0.1
COLONY_MYSQL_PORT=3306
COLONY_MYSQL_USER=
COLONY_MYSQL_PASSWORD=
COLONY_MYSQL_DB=colony_dash

# --- tuning ------------------------------------------------------------------
# These are read from the real environment at import time, before `.env` is
# loaded, so setting them HERE does nothing. Export them in the shell (or in the
# scheduled task) if you want them. Listed for discoverability; the defaults are
# deliberate and you should not need to touch them.
#
#   COLONY_BUILD_LIMIT=1      how many build agents may run in one wake
#   COLONY_BUILD_TIMEOUT=900  seconds before a build agent is killed
#   COLONY_GROOM_LIMIT=2      stories groomed per wake
#   COLONY_GROOM_TIMEOUT=420
#   COLONY_STAFF_LIMIT=1      hiring decisions per wake
#   COLONY_STAFF_TIMEOUT=420
#   COLONY_REPLY_LIMIT=3      PO replies answered per wake
#   COLONY_REPLY_TIMEOUT=300
#   COLONY_FORGE_LIMIT=1      skill drafts per wake
