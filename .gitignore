# The ledger and everything the colony produces at runtime.
.colony/
*.db
*.db-wal
*.db-shm

# Secrets. Never committed, never readable by an agent.
.env

__pycache__/
*.pyc

# Written and moved into place by `phone.rotate()`. Never survives a
# successful call, but a crash mid-write could leave one holding a token.
.env.new
